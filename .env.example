PORT=3000
JWT_SECRET=your-very-secret-jwt-key-change-this
NODE_ENV=development

# Email configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=yourpassword
SMTP_FROM=noreply@yourcompany.com

# Admin default credentials (change after first login)
ADMIN_EMAIL=admin@leadportal.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrator

# Anthropic Claude API (für KI-Features: Strategie-Analyse, Anzeigentexte, etc.)
# Erhältlich unter: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Google APIs (optional – für Brand-Recherche, Bewertungen & Wettbewerber-Analyse)
# 1. Google Cloud Console: https://console.cloud.google.com
#    → APIs aktivieren: "Places API" + "Custom Search API"
#    → API-Key erstellen unter "Credentials"
GOOGLE_API_KEY=

# 2. Programmable Search Engine (für Wettbewerber-Suche)
#    → Erstellen unter: https://programmablesearchengine.google.com
#    → Search Engine ID (cx) hier eintragen
GOOGLE_SEARCH_ENGINE_ID=
